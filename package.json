{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test tests/migrations.test.mjs tests/cloudflare-config.test.mjs tests/media-storage.test.mjs tests/admin-setup.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:local": "node scripts/local-db.mjs migrate",
    "db:seed": "node scripts/local-db.mjs seed",
    "admin:local": "node scripts/local-db.mjs admin",
    "test:integration": "node --test --test-concurrency=1 tests/community-api.test.mjs tests/rendered-html.test.mjs tests/rewards-api.test.mjs",
    "types": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types worker-configuration.d.ts --env-interface CloudflareEnv",
    "typecheck": "pnpm types && tsc --noEmit",
    "cf:check": "node scripts/cloudflare.mjs check",
    "cf:build": "node scripts/cloudflare.mjs build",
    "cf:dry-run": "node scripts/cloudflare.mjs dry-run",
    "cf:deploy": "node scripts/cloudflare.mjs deploy",
    "cf:admin": "node scripts/cloudflare.mjs admin",
    "preview": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite preview --host 127.0.0.1",
    "test:preview": "node scripts/smoke-preview.mjs",
    "cf:admin:create": "node scripts/provision-admin.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0"
}
